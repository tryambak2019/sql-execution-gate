project_id = "gcplab20250706"
region     = "us-central1"

# Run jobs in project_id while reading the public TheLook dataset.
data_project_id = "bigquery-public-data"
dataset_id      = "thelook_ecommerce"

# Reuse the repository already used by bqbot.
artifact_repository_id     = "bigquery-bot-repo"
create_artifact_repository = false

# Google sends a one-time verification message before alerts are delivered.
engagement_alert_email = "dev.ocicloud26@yahoo.com"

